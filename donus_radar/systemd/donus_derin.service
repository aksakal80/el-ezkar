[Unit]
Description=Dönüş Radarı - haftalık geçmiş tamamlama (yeni listelenen coinler için)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/root/sinyal/donus_radar
ExecStart=/root/sinyal/venv/bin/python3 /root/sinyal/donus_radar/donus_radar.py --derin
Nice=15
TimeoutStartSec=90min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=false
ProtectHome=false
